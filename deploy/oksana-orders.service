# /etc/systemd/system/oksana-orders.service
#   systemctl daemon-reload && systemctl enable --now oksana-orders
#   журнал: journalctl -u oksana-orders -f
# Node 20+ должен быть в /usr/bin (NodeSource / официальный пакет): из apt Ubuntu ставится слишком старый,
# а nvm в домашнем каталоге не виден из-за ProtectHome.
[Unit]
Description=Oksana Vdovina — orders API
After=network-online.target

[Service]
Type=simple
User=oksana
WorkingDirectory=/var/www/oksana/repo
EnvironmentFile=/var/www/oksana/repo/.env
# Заказы — в /var/lib/oksana-orders (systemd создаёт каталог с владельцем oksana); перекрывает ORDERS_DIR из .env
StateDirectory=oksana-orders
StateDirectoryMode=0700
Environment=ORDERS_DIR=/var/lib/oksana-orders
# Номера заказов и даты — по времени Челябинска
Environment=TZ=Asia/Yekaterinburg
ExecStart=/usr/bin/node dist-server/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
