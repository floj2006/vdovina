# Каждый сайт — отдельный блок. Бэкенды — алиасы контейнеров в сети edge.

# --- Ольга Жукова (/opt/olga) ---
olga-zhukova-vologda.ru {
    encode zstd gzip
    request_body {
        max_size 9MB
    }
    reverse_proxy olga-app:3000 {
        header_up X-Real-IP {remote_host}
    }
}

www.olga-zhukova-vologda.ru {
    redir https://olga-zhukova-vologda.ru{uri} permanent
}

