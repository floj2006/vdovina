# Скопируйте в .env на сервере (chmod 600 .env). Файл не коммитится.

# --- Сайт (подставляется при сборке) ---
# Домен без слэша: canonical, og:url, sitemap.xml
VITE_SITE_URL=https://example.ru
# Номер счётчика Яндекс Метрики
VITE_YM_ID=

# --- API заказов (deploy/compose.yaml) ---
# Должен совпадать с VITE_SITE_URL: заказы принимаются только с этого домена
SITE_URL=https://example.ru
PORT=3001
# На сервере PORT и ORDERS_DIR задаёт deploy/compose.yaml; эти значения — для локального запуска
ORDERS_DIR=./orders

# Бот MAX: токен — business.max.ru → Чат-боты; chat_id — npm run max:chat-id
MAX_BOT_TOKEN=
MAX_CHAT_ID=
# Новый адрес API требует сертификат Минцифры в системе; старый работает со стандартными
MAX_API_URL=https://platform-api.max.ru
