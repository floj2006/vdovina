# --- Сервер (Vercel → Settings → Environment Variables) ---
# Токен бота от @BotFather и id чата, куда слать заказы
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Сборка (подставляются в клиентский код, не секретные) ---
# Домен без слэша: canonical, og:url, sitemap.xml
VITE_SITE_URL=
# Номер счётчика Яндекс Метрики
VITE_YM_ID=
